# Source checkpoint and complete converted video VAE; never put credentials here.
MVH3_CHECKPOINT=/path/to/MiniMax-H3/FL2VA
MVH3_VAE=/path/to/converted/vae
MVH3_DATA_ROOT=/path/to/first/dataset/root
MVH3_DATA_ROOT3=/path/to/second/dataset/root
MVH3_TEXT_CACHE=local/qwen3_layer50
# Optional workaround tested on the current PyTorch 2.12 / NCCL 2.29 host.
# All ranks synchronize all CUDA work before using abort to release communicators.
MVH3_NCCL_ABORT_ON_EXIT=1
